DATABASE_URL=postgresql+psycopg://rag:change-me@localhost:5432/rag_assistant
ASSISTANT_API_KEY=replace-with-a-long-random-value

RAG_CORPUS_DIR=data/rag_epi_3_machines
RAG_TOP_K=6
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

FORECAST_RESULTS_PATH=forecast_results.json
FORECAST_DEFAULT_UNIT=W
FORECAST_NAIVE_TIMEZONE=UTC

ASSISTANT_IMAGE=epi-rag-assistant:local
RUN_MIGRATIONS=true
RAG_INGEST_ON_STARTUP=false
